{
  "name": "s4-test",
  "version": "1.0.0",
  "description": "Minimal CAP project to test the S/4 connection via destination SCB_VanStock_400",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "mbt": "^1.2.49"
  },
  "scripts": {
    "start": "cds-serve",
    "build": "mbt build --mtar s4-test",
    "deploy": "cf deploy mta_archives/s4-test.mtar"
  },
  "cds": {
    "requires": {
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      },
      "VanStock": {
        "kind": "odata",
        "model": "srv/external/VanStock",
        "[production]": {
          "credentials": {
            "destination": "SCB_VanStock_400",
            "path": "/sap/opu/odata4/sap/zmm_van_stock_profile_list_rsb/srvd/sap/zmm_van_stock_profile_list_rsd/0001"
          }
        }
      },
      "ProductInformation": {
        "kind": "odata",
        "model": "srv/external/ProductInformation",
        "[production]": {
          "credentials": {
            "destination": "SCB_VanStock_400",
            "path": "/sap/opu/odata4/sap/zmm_material_profitctr_sb/srvd/sap/zmm_material_profitctr_sd/0001"
          }
        }
      }
    }
  }
}
